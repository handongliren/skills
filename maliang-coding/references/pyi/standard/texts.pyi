    def append(self, value: str, show: str | None) -> None: ...
    def remove(self, start: int, end: int | None) -> None: ...
    def pop(self, index: int) -> str: ...
    def clear(self) -> None: ...
    def select_get(self) -> tuple[int, int] | None: ...
