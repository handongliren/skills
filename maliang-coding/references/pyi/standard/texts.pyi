class _CanvasTextProxy:
    def __init__(self, canvas: containers.Canvas, tag_or_id: str | int) -> None: ...
    def length(self) -> int: ...
    def get(self) -> str: ...
    def set(self, value: str, show: str | None) -> None: ...
